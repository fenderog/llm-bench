; Engine configuration file.
; Voxel Sandbox - self-contained Godot 4.7 project.

config_version=5

[application]

config/name="Voxel Sandbox Runner"
config/description="A voxel character running around in a small sandbox environment."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
driver/threads/thread_model=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.92, 1)
