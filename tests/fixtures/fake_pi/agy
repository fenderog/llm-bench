#!/usr/bin/env python3
"""Fake Antigravity CLI: no model calls."""
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
if '--version' in args:
    print('1.3.3-fake')
elif args == ['models']:
    print('gemini-3.8-flash-high\tGemini Flash High\ngemini-3.8-flash-low\tGemini Flash Low\nclaude-opus-5-5-medium\tClaude Medium')
elif '-p' in args:
    if os.environ.get('FAKE_AGY_ARGV'):
        Path(os.environ['FAKE_AGY_ARGV']).write_text(json.dumps(args))
    brief = args[args.index('-p') + 1]
    Path('output').mkdir(exist_ok=True)
    Path('output/circle.svg').write_text('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4"/></svg>')
    events = [
        {'event': 'init', 'init': {'cwd': os.getcwd(), 'model': args[args.index('--model') + 1]}},
        {'event': 'step_update', 'step_update': {'step_index': 1, 'step_type': 'tool', 'state': 'ACTIVE'}},
        {'event': 'step_update', 'step_update': {'step_index': 1, 'step_type': 'tool', 'state': 'DONE', 'tool_name': 'run_command', 'duration_seconds': 0.2, 'tool_info': {'name': 'run_command', 'parameters': {'CommandLine': 'echo hi'}, 'output': 'hi'}}},
        {'event': 'step_update', 'step_update': {'step_index': 2, 'step_type': 'agent_response', 'state': 'ACTIVE', 'text_delta': 'Done'}},
        {'event': 'step_update', 'step_update': {'step_index': 2, 'step_type': 'agent_response', 'state': 'DONE', 'text_delta': '!'}},
        {'event': 'result', 'result': {'status': 'ERROR' if os.environ.get('FAKE_AGY_ERROR') else 'SUCCESS', 'error': 'model error' if os.environ.get('FAKE_AGY_ERROR') else None, 'response': 'Done!', 'num_turns': 1, 'usage': {'input_tokens': 9, 'output_tokens': 5, 'thinking_tokens': 2, 'cache_read_tokens': 50}}},
    ]
    for e in events:
        print(json.dumps(e), flush=True)
else:
    sys.exit(2)
